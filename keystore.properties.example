# Option 1: Copy this file to keystore.properties and provide values locally.
# Option 2: Set WRITON_RELEASE_STORE_FILE, WRITON_RELEASE_STORE_PASSWORD,
# WRITON_RELEASE_KEY_ALIAS, and WRITON_RELEASE_KEY_PASSWORD in the environment.
# Do not commit keystore.properties or the referenced keystore file.
storeFile=../keys/writon-upload.jks
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=REPLACE_WITH_KEY_ALIAS
keyPassword=REPLACE_WITH_KEY_PASSWORD
