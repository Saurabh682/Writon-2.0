<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popup_element"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="#efebe9"
    android:orientation="vertical"
    android:elevation="25dp"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="right">

        <TextView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:id="@+id/TVClose"
            android:background="@drawable/ic_clear_black_24dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

    <TextView
        android:id="@+id/txtView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#000000"
        android:textSize="18dp"
        android:layout_marginTop="5sp"
        android:text="Text Size: " />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:orientation="horizontal">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="7dp"
            android:id="@+id/fontSizeSmall"
            android:src="@drawable/ic_text_format_black_24dp"/>

        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="4dp"
            android:id="@+id/fontSizeMedium"
            android:src="@drawable/ic_text_format_black_24dp"/>

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="10dp"
            android:id="@+id/fontSizeLarge"
            android:src="@drawable/ic_text_format_black_24dp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/LLColorLayout"
        android:gravity="left"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:layout_gravity="center"
            android:textSize="18dp"
            android:text="Background Color: "/>

        <View
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:id="@+id/View2"
            android:layout_marginLeft="20dp"
            android:background="#ffffff" />
        <View
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:id="@+id/View3"
            android:layout_marginLeft="5dp"
            android:background="#e7dec7" />
        <View
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:id="@+id/View4"
            android:layout_marginLeft="5dp"
            android:background="#000000" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:gravity="center">

        <Button
            android:id="@+id/BTNReset"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_alignParentBottom="true"
            android:layout_below="@+id/no_of_follower"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="10dp"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="10dp"
            android:background="@color/colorPrimary"
            android:text="Reset"
            android:textColor="@color/colorWhite"
            android:textSize="12dp" />
    </LinearLayout>

</LinearLayout>