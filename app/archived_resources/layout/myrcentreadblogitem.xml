    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/LlB"
        android:layout_toRightOf="@+id/thumbnail2"
        android:layout_below="@id/TVWrite">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="15dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="14dp"
            android:src="@drawable/ic_eye" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/TVbookmarkCount"
            android:textColor="#959FC4"
            android:layout_gravity="bottom"
            android:layout_marginBottom="6.5dp"
            android:layout_marginLeft="0dp"
            android:text="0" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="30dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="8dp"
            android:layout_marginLeft="22dp"
            android:src="@drawable/ic_chat" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/TVCommentCount"
            android:textColor="#959FC4"
            android:layout_gravity="bottom"
            android:layout_marginBottom="6.5dp"
            android:layout_marginLeft="4dp"
            android:text="0" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="30dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="6.5dp"
            android:layout_marginLeft="22dp"
            android:src="@drawable/ic_star" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/TVRating"
            android:textColor="#959FC4"
            android:layout_gravity="bottom"
            android:layout_marginBottom="6.5dp"
            android:layout_marginLeft="4dp"
            android:text="0.0" />
    </LinearLayout>

    <LinearLayout android:id="@+id/thumbnail2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="3dip"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/list_image2"
            android:layout_width="50dip"
            android:layout_height="50dip"
            android:layout_marginTop="8dp"
            app:civ_border_width="@dimen/size_0"
            app:civ_border_color="@color/colorBlack"
            />

    </LinearLayout>


