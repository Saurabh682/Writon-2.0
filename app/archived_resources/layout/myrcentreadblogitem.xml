<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FFFFFF"
    android:elevation="5dp"
    android:orientation="horizontal"
    android:layout_marginTop="5dp"
    android:padding="5dip">

    <!--  ListRow Left sied Thumbnail image -->

    <!-- Title Of Song-->
    <TextView
        android:id="@+id/TVTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLength="30"
        android:layout_marginLeft="@dimen/spacing_4"
        android:layout_marginTop="5dp"
        android:layout_alignTop="@+id/thumbnail2"
        android:layout_toRightOf="@+id/thumbnail2"
        android:text="My Little Sunshine"
        android:textColor="#404041"
        android:textSize="17dip"
        android:textStyle="bold" />

    <!-- Artist Name -->
    <TextView
        android:id="@+id/TVWrite"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/TVTitle"
        android:layout_marginLeft="@dimen/spacing_4"
        android:textColor="#6D6E70"
        android:textSize="14dip"
        android:alpha=".8"
        android:layout_marginTop="1dip"
        android:layout_toRightOf="@+id/thumbnail2"
        android:text="Mirinda Kerr (Short Story, Romance)" />

