<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDF9F7"
    android:clipToPadding="false"
    tools:context="com.ibitvalley.writon.ShowBlogDetails">

<ProgressBar
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:id="@+id/progress_bar"
    android:elevation="1dp"
    android:visibility="gone"
    android:layout_centerInParent="true"/>
    <ScrollView
        android:id="@+id/activity_show_blog_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/size_45"
        >
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_35"
            android:clipToPadding="false"

            >
            <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:alpha=".6"

            android:src="@drawable/read_pic" />
        <androidx.cardview.widget.CardView
            android:layout_marginTop="300dp"
            android:layout_marginVertical="300dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_15"
            app:cardCornerRadius="10dp"
            app:cardElevation="30dp"
            android:clipToPadding="false"
            >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="@dimen/spacing_10"
        >


        <TextView
            android:id="@+id/TVTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="Title"
            android:textColor="@color/colorBlack"
            android:fontFamily="@font/lato"
            android:textSize="18dp" />
        <TextView
            android:id="@+id/writer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="\@name"
            android:textColor="@color/colorBlack"
            android:fontFamily="@font/lato_light"
            android:textSize="14dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp">

            <TextView
                android:id="@+id/TVDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:textSize="16dp"/>
        </LinearLayout>
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="right">
        </LinearLayout>








        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/tv_Category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#7E72B3"
                android:textSize="14dp" />


            <TextView
                android:id="@+id/tv_subCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginLeft="12dp"
                android:background="@drawable/rounded_corner"
                android:textColor="@color/colorWhite"
                android:textSize="14dp"
                android:visibility="gone"/>




            <TextView
                android:id="@+id/tv_language"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginLeft="12dp"
                android:background="@drawable/rounded_corner"
                android:textColor="@color/colorWhite"
                android:textSize="14dp"
                android:visibility="gone"/>




        </LinearLayout>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:id="@+id/LLContent2"
            android:layout_below="@+id/LLContent"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_eye"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:id="@+id/TVViewCount"
                        android:layout_marginLeft="5dp"
                        android:textSize="12dip"
                        android:textColor="#959FC4"
                        android:text="0"/>
                </LinearLayout>


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp">
                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_chat"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:id="@+id/TVCommentCount"
                        android:layout_marginLeft="5dp"
                        android:textSize="12dip"
                        android:textColor="#959FC4"
                        android:text="0"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp">
                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginTop="1dp"
                        android:src="@drawable/ic_star"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:id="@+id/TVRating"
                        android:layout_marginLeft="5dp"
                        android:textColor="#959FC4"
                        android:textSize="12dip"
                        android:text="0"/>
                </LinearLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/img_Option"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:visibility="visible"
                        android:layout_alignParentRight="true"
                        android:layout_marginRight="20dp"
                        android:src="@drawable/ic_share"/>
                </RelativeLayout>

            </LinearLayout>


        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="20dp"
            android:background="#9E9E9E"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/size_10"
            android:paddingTop="@dimen/size_10"
            android:orientation="horizontal"
            >
            <FrameLayout
                android:id="@+id/Frame_Bookmark"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                >

                <ImageView
                    android:id="@+id/img_bookmark"
                    android:layout_width="18dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:src="@drawable/bookmarkblue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="35dp"
                    android:fontFamily="@font/lato_bold"
                    android:textAllCaps="true"
                    android:text="Bookmark"
                    android:textSize="10sp"

                    />

            </FrameLayout>


            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:background="#9E9E9E"/>

            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:id="@+id/Frame_Rate"
                >

                <ImageView
                    android:id="@+id/img_rating"
                    android:layout_width="22dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:src="@drawable/starblue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="35dp"
                    android:fontFamily="@font/lato_bold"
                    android:textAllCaps="true"
                    android:text="Rate"
                    android:textSize="10sp"

                    />
            </FrameLayout>


            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:background="#9E9E9E"/>

            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:id="@+id/Frame_Share"
                >

                <ImageView
                    android:id="@+id/img_share"
                    android:layout_width="22dp"
                    android:layout_marginTop="4dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:src="@drawable/shareblue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="35dp"
                    android:fontFamily="@font/lato_bold"
                    android:textAllCaps="true"
                    android:text="SHARE"
                    android:textSize="10sp"
                    />
            </FrameLayout>

        </LinearLayout>



        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="10dp"
            android:background="#9E9E9E"/>



        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">



            <androidx.cardview.widget.CardView
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:cardElevation="0dp"
                android:id="@+id/thumbnail"
                app:cardCornerRadius="40dp"
                android:innerRadius="0dp"
                android:layout_marginTop="5dp"
                android:shape="ring"
                android:layout_alignParentLeft="true"
                android:layout_marginLeft="0dp">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/list_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:layout_margin="5dp"
                    app:civ_border_width="0dp"
                    app:civ_border_color="@color/colorBlack"
                    android:src="@drawable/userprofilepic"/>


            </androidx.cardview.widget.CardView>

            <!-- Title Of Song-->

            <TextView
                android:id="@+id/TVWriterName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignLeft="@+id/tv_user_followers_count"
                android:ellipsize="marquee"
                android:maxLength="25"
                android:text="Mindy Kaling"
                android:textColor="#404041"
                android:textSize="17dip"
                android:textStyle="bold" />

            <!-- Artist Name -->
            <TextView
                android:id="@+id/tv_user_followers_count"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="@id/thumbnail"
                android:textColor="#6D6E70"
                android:textSize="12dip"
                android:layout_marginTop="25dp"
                android:layout_marginLeft="20dp"
                android:layout_toRightOf="@+id/thumbnail"
                android:text="0 followers" />




            <Button
                android:id="@+id/TVFollow"
                android:layout_width="90dp"
                android:layout_height="25dp"
                android:layout_below="@id/tv_user_followers_count"
                android:layout_alignLeft="@id/tv_user_followers_count"
                android:text="Follow"
                android:textSize="10dp"

                android:background="@drawable/rounded_button_blue"
                android:padding="1dp"
                android:layout_marginTop="2dp"
                android:textColor="@color/colorWhite"
                android:layout_marginLeft="-4dp" />



        </RelativeLayout>



    </LinearLayout>
    </androidx.cardview.widget.CardView>
    </androidx.appcompat.widget.LinearLayoutCompat>

</ScrollView>
<LinearLayout
        android:id="@+id/ll_Discuss"
        android:layout_width="200dp"
        android:layout_height="45dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:background="@drawable/rounded_button_blue"
        android:gravity="center">



            <TextView
                android:id="@+id/tv_comment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Discuss"
                android:textColor="@color/colorWhite"
                android:textSize="18dip"
                android:textStyle="bold"
                android:fontFamily="@font/lato_bold"/>

            <ImageView
                android:id="@+id/img_comment"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:src="@drawable/discuss"
                 />



    </LinearLayout>





</RelativeLayout>
