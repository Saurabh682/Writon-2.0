<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="@dimen/size_20"
    app:cardCornerRadius="20dp"
    android:id="@+id/TVFirst"
    app:cardElevation="40dp"
    android:background="@color/colorWhite"
    >

<!--<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:id="@+id/TVFirst"
    android:background="@color/bgColor">-->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="@dimen/size_10"
        android:orientation="vertical"

        >
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:alpha=".6"
            android:src="@drawable/write_pic" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="*Choose category/ language"
            android:textColor="@color/greyblue"
            />

        <Spinner
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:spinnerMode="dropdown"
            android:textSize="18dp"
            android:layout_marginTop="15dp"
            android:entries="@array/array_mainCategory"
            android:textColor="@color/newColorGrey"
            android:padding="2dp"
            android:background="#f4f3fa"
            style=""
            android:id="@+id/tv_categoryName">
        </Spinner>


        <Spinner
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:spinnerMode="dropdown"
            android:textSize="18dp"
            android:layout_marginTop="15dp"
            android:entries="@array/array_subCategory"
            android:textColor="@color/verylightPurple"
            android:padding="2dp"
            android:background="#f4f3fa"
            style="@style/Base.Widget.AppCompat.Spinner.Underlined"
            android:id="@+id/tv_categoryL2">
        </Spinner>


        <Spinner
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:spinnerMode="dropdown"
            android:textSize="18dp"
            android:layout_marginTop="15dp"
            android:entries="@array/array_language"
            android:textColor="@color/verylightPurple"
            android:padding="2dp"
            android:background="#f4f3fa"
            style="@style/Base.Widget.AppCompat.Spinner.Underlined"
            android:id="@+id/SPLanguage">
        </Spinner>



        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="@dimen/size_10"
            android:textSize="18dp"
            android:textColor="@color/newColorGrey"
            android:text="Short Description"/>

        <EditText
            android:id="@+id/tv_shortDesc"
            android:layout_width="fill_parent"
            android:layout_height="133dp"
            android:layout_marginTop="5dp"
            android:background="#f3f1fc"
            android:padding="2dp"
            android:textColor="@color/newColorGrey"
            android:tooltipText="Try writing a decent description which will attract more viewer"
            android:textSize="18dp" />

        <!--android:hint="This will be required at the time of publishing you may fill it later at that time."-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center">
            <!--<TextView-->
                <!--android:layout_width="150dp"-->
                <!--android:layout_height="wrap_content"-->
                <!--android:textAlignment="center"-->
                <!--android:id="@+id/BtnStart"-->
                <!--android:padding="10dp"-->
                <!--android:background="#0277bd"-->
                <!--android:textColor="#FFFFFF"-->
                <!--android:textSize="21dp"-->
                <!--android:text="Start"/>-->

            <Button
                android:id="@+id/BtnStart"
                android:layout_width="252dp"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/round_corner_button"
                android:elevation="40dp"
                android:text="  Start Writing "
                android:textColor="@color/colorWhite"
                android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"></LinearLayout>
    </LinearLayout>
    </ScrollView>
<!--</LinearLayout>-->
</androidx.cardview.widget.CardView>