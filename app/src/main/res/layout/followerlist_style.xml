<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_feed"
    android:layout_width="170dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:cardCornerRadius="5dp"
    app:cardElevation="8dp"
    android:layout_marginTop="@dimen/spacing_15"
    android:layout_marginLeft="@dimen/spacing_15"
    android:outlineAmbientShadowColor="@color/purple"
    app:cardBackgroundColor="@color/colorWhite"
    tools:context="com.ibitvalley.writon.Feed"
    android:layout_marginStart="@dimen/spacing_15">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:gravity="center"
        >


        <androidx.cardview.widget.CardView
            android:id="@+id/thumbnail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/list_imageone"
                android:layout_width="170dp"
                android:layout_height="120dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:foregroundGravity="center"

                android:scaleType="centerCrop"
                android:src="@drawable/profile_unfilled" />


        </androidx.cardview.widget.CardView>

        <!-- Title Of Song-->

        <!-- Artist Name -->
        <LinearLayout
            android:id="@+id/LLContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/thumbnail"
            android:orientation="vertical"
            android:gravity="center"
            >


            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Mindy Kaling"

                android:textColor="#404041"
                android:textSize="14dip"
                android:textStyle="bold" />
        </LinearLayout>


        <TextView
            android:id="@+id/tv_user_followers_count"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/LLContent"
            android:text="0 followers"
            android:textColor="#6D6E70"
            android:gravity="center"
            android:textSize="12dip" />

        <Button
            android:id="@+id/TVFollow"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_below="@id/tv_user_followers_count"
            android:background="@color/lightBlue"
            android:padding="1dp"
            android:text="Follow"
            android:textAllCaps="true"
            android:gravity="center"
            android:textColor="@color/colorWhite"
            android:textSize="10dp" />




    </RelativeLayout>

</androidx.cardview.widget.CardView>

