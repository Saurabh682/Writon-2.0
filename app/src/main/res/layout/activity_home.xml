<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#e8e8e8">


    <FrameLayout
        android:layout_above="@+id/layout_bottom"
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/layout_bottom"
        android:layout_width="match_parent"
        android:weightSum="5"
        android:background="@color/colorWhite"
        android:orientation="horizontal"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true">


        <RelativeLayout
            android:id="@+id/layout_home"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent">


            <ImageView
                android:id="@+id/img_category"
                android:layout_width="28dp"
                android:layout_centerInParent="true"
                android:src="@drawable/burgermenu"
                android:layout_height="28dp" />


        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/layout_home1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent">


            <ImageView
                android:id="@+id/img_explorer"
                android:layout_width="28dp"
                android:layout_centerInParent="true"
                android:src="@drawable/explore_linemdpi"
                android:layout_height="28dp" />


        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/layout_home2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent">


            <ImageView
                android:id="@+id/img_myworld"
                android:layout_width="28dp"
                android:layout_centerInParent="true"
                android:src="@drawable/home_linemdpi"
                android:layout_height="28dp" />


        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/layout_home3"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent">


            <ImageView
                android:id="@+id/img_bookmark"
                android:layout_width="28dp"
                android:layout_centerInParent="true"
                android:src="@drawable/bookmark_linemdpi"
                android:layout_height="28dp" />


        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/layout_home4"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent">


            <ImageView
                android:id="@+id/img_profile"
                android:layout_width="32dp"
                android:layout_centerInParent="true"
                android:src="@drawable/profile_linemdpi"
                android:layout_height="32dp" />


        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>
