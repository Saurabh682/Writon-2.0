<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff"
    tools:context="com.ibitvalley.writon.ShowBlogDetails">


    <ScrollView
        android:id="@+id/activity_show_blog_details"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#ffffff"
        android:layout_marginBottom="50dp"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/TVTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:textColor="@color/colorBlack"
            android:textSize="18dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp">

            <TextView
                android:id="@+id/TVDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:textSize="16dp"/>
        </LinearLayout>
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="right">
        </LinearLayout>

        <!--<TextView-->
            <!--android:layout_width="wrap_content"-->
            <!--android:layout_height="wrap_content"-->
            <!--android:id="@+id/TVWriterName"-->
            <!--android:visibility="gone"-->
            <!--android:layout_gravity="right"-->
            <!--android:textStyle="bold"-->
            <!--android:textSize="16dp"-->
            <!--android:text=""/>-->







        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/tv_Category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#7E72B3"
                android:textSize="14dp" />


            <TextView
                android:id="@+id/tv_subCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginLeft="12dp"
                android:background="@drawable/rounded_corner"
                android:textColor="@color/colorWhite"
                android:textSize="14dp"
                android:visibility="gone"/>




            <TextView
                android:id="@+id/tv_language"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginLeft="12dp"
                android:background="@drawable/rounded_corner"
                android:textColor="@color/colorWhite"
                android:textSize="14dp"
                android:visibility="gone"/>




        </LinearLayout>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:id="@+id/LLContent2"
            android:layout_below="@+id/LLContent"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_eye"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:id="@+id/TVViewCount"
                        android:layout_marginLeft="5dp"
                        android:textSize="12dip"
                        android:textColor="#959FC4"
                        android:text="24k"/>
                </LinearLayout>


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp">
                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_chat"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:id="@+id/TVCommentCount"
                        android:layout_marginLeft="5dp"
                        android:textSize="12dip"
                        android:textColor="#959FC4"
                        android:text="52"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp">
                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginTop="1dp"
                        android:src="@drawable/ic_star"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:id="@+id/TVRating"
                        android:layout_marginLeft="5dp"
                        android:textColor="#959FC4"
                        android:textSize="12dip"
                        android:text="406"/>
                </LinearLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/img_Option"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:visibility="visible"
                        android:layout_alignParentRight="true"
                        android:layout_marginRight="20dp"
                        android:src="@drawable/ic_share"/>
                </RelativeLayout>

            </LinearLayout>


        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="20dp"
            android:background="#9E9E9E"/>



        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">



            <androidx.cardview.widget.CardView
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:cardElevation="0dp"
                android:id="@+id/thumbnail"
                app:cardCornerRadius="40dp"
                android:innerRadius="0dp"
                android:layout_marginTop="5dp"
                android:shape="ring"
                android:layout_alignParentLeft="true"
                android:layout_marginLeft="0dp">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/list_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:layout_margin="5dp"
                    app:civ_border_width="0dp"
                    app:civ_border_color="@color/colorBlack"
                    android:src="@drawable/userprofilepic"/>


            </androidx.cardview.widget.CardView>

            <!-- Title Of Song-->

            <TextView
                android:id="@+id/TVWriterName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignLeft="@+id/tv_user_followers_count"
                android:text="Mindy Kaling"
                android:textColor="#404041"
                android:textSize="17dip"
                android:textStyle="bold"/>

            <!-- Artist Name -->
            <TextView
                android:id="@+id/tv_user_followers_count"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="@id/thumbnail"
                android:textColor="#6D6E70"
                android:textSize="12dip"
                android:layout_marginTop="25dp"
                android:layout_marginLeft="20dp"
                android:layout_toRightOf="@+id/thumbnail"
                android:text="0 followers" />




            <Button
                android:id="@+id/TVFollow"
                android:layout_width="90dp"
                android:layout_height="25dp"
                android:layout_below="@id/tv_user_followers_count"
                android:layout_alignLeft="@id/tv_user_followers_count"
                android:text="Follow"
                android:textSize="10dp"

                android:background="@drawable/rounded_button_blue"
                android:padding="1dp"
                android:layout_marginTop="2dp"
                android:textColor="@color/colorWhite"
                android:layout_marginLeft="-4dp" />

        </RelativeLayout>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" >
            <ImageView
                android:id="@+id/img_bookmark"
                android:layout_width="15dp"
                android:layout_height="22dp"
                android:layout_alignParentRight="true"
                android:src="@drawable/unbookmark"
                android:layout_marginTop="4dp"
                android:layout_marginRight="30dip"/>

            <ImageView
                android:id="@+id/img_rating"
                android:layout_width="15dp"
                android:layout_height="22dp"
                android:layout_alignParentRight="true"
                android:src="@drawable/starnew"
                android:layout_marginTop="4dp"
                android:layout_marginRight="0dip"/>


            <ImageView
                android:id="@+id/img_share"
                android:layout_width="15dp"
                android:layout_height="22dp"
                android:layout_alignParentRight="true"
                android:src="@drawable/shareblog"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                android:layout_marginRight="0dip"/>

        </RelativeLayout>



        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="20dp"
            android:background="#BDBDBD"/>
    </LinearLayout>

    </ScrollView>




        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#F5F5F5"
            android:gravity="center"
            android:visibility="visible"
            android:layout_alignParentBottom="true">

           <LinearLayout
               android:id="@+id/ll_Discuss"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="horizontal"
               android:gravity="center">

               <TextView
                   android:id="@+id/tv_comment"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_centerInParent="true"
                   android:text="Comment"
                   android:textColor="#404041"
                   android:textSize="17dip"
                   android:textStyle="bold"/>

               <ImageView
                   android:id="@+id/img_comment"
                   android:layout_width="15dp"
                   android:layout_height="22dp"
                   android:layout_alignRight="@+id/tv_comment"
                   android:src="@drawable/ic_chat"
                   android:layout_marginTop="4dp"
                   android:layout_marginLeft="10dp"/>

           </LinearLayout>



        </RelativeLayout>





</RelativeLayout>
