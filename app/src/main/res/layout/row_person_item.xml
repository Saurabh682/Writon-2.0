<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_feed"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:cardCornerRadius="5dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/colorWhite"
    android:layout_margin="5dp"
    android:padding="5dp"
    tools:context="com.ibitvalley.writon.Feed">



    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:layout_margin="20dp">



        <androidx.cardview.widget.CardView
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:cardElevation="0dp"
            android:id="@+id/thumbnail"
            app:cardCornerRadius="10dp"
            android:innerRadius="0dp"
            android:layout_marginTop="5dp"
            android:shape="ring"
            android:layout_alignParentLeft="true"
            android:layout_marginLeft="5dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/list_imageone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layout_margin="5dp"
                android:src="@drawable/userprofilepic"></de.hdodenhof.circleimageview.CircleImageView>


        </androidx.cardview.widget.CardView>

        <!-- Title Of Song-->

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignLeft="@+id/tv_user_followers_count"
            android:text="Mindy Kaling"
            android:textColor="#404041"
            android:textSize="17dip"
            android:textStyle="bold"/>

        <!-- Artist Name -->
        <TextView
            android:id="@+id/tv_user_followers_count"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="@id/thumbnail"
            android:textColor="#6D6E70"
            android:textSize="12dip"
            android:layout_marginTop="25dp"
            android:layout_marginLeft="20dp"
            android:layout_toRightOf="@+id/thumbnail"
            android:text="0 followers" />




        <Button
            android:id="@+id/TVFollow"
            android:layout_width="90dp"
            android:layout_height="25dp"
            android:layout_below="@id/tv_user_followers_count"
            android:layout_alignLeft="@id/tv_user_followers_count"
            android:text="Follow"
            android:textSize="10dp"
            android:background="@drawable/rounded_button_blue"
            android:padding="1dp"
            android:layout_marginTop="2dp"
            android:textColor="@color/colorWhite"
            android:layout_marginLeft="-4dp" />


        <LinearLayout
            android:id="@+id/LLContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/thumbnail"
            android:layout_marginTop="20dp"
            android:layout_marginRight="6dp"
            android:orientation="vertical">


        </LinearLayout>


    </RelativeLayout>

</androidx.cardview.widget.CardView>

