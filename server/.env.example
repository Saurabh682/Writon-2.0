# Local runtime configuration. Do not put real values in this file.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
SUPABASE_STORAGE_BUCKET=writon-media
PUBLIC_API_BASE_URL=https://api.example.com
DATABASE_POOL_MAX=10
# Supabase's local pooled connection can require this to be false.
# Production defaults to true unless explicitly changed.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
LATEST_APP_VERSION_CODE=112
MIN_SUPPORTED_APP_VERSION_CODE=101
PLAY_STORE_APP_URL=https://play.google.com/store/apps/details?id=com.ibitvalley.writon
PUSH_DELIVERY_POLL_INTERVAL_MS=30000

# For local development, place serviceAccountKey.json in server/ (it is ignored).
# For production, inject one of the following through your deployment secret store:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
# FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json

# Required in production; comma-separated browser origins.
# CORS_ORIGINS=https://app.example.com
