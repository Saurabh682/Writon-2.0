# Local runtime configuration. Do not put real values in this file.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
SUPABASE_STORAGE_BUCKET=writon-media
PUBLIC_API_BASE_URL=https://api.example.com
PUSH_DELIVERY_ENABLED=true
DATABASE_POOL_MAX=10
# Supabase's local pooled connection can require this to be false.
# Production defaults to true unless explicitly changed.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
LATEST_APP_VERSION_CODE=119
# Last version confirmed installable from Google Play. Do not set this from CI.
PUBLISHED_APP_VERSION_CODE=108
MIN_SUPPORTED_APP_VERSION_CODE=101
PLAY_STORE_APP_URL=https://play.google.com/store/apps/details?id=com.ibitvalley.writon
PUSH_DELIVERY_POLL_INTERVAL_MS=30000

# Request-based Cloud Run instances may be suspended outside requests. Keep the
# in-process digest timer disabled there and invoke the internal scheduler route
# from Cloud Scheduler with the same ADMIN_SECRET_KEY in its x-admin-key header.
DAILY_DIGEST_ENABLED=false
DAILY_DIGEST_HOUR_UTC=14
DAILY_DIGEST_MINUTE_UTC=30
# ADMIN_SECRET_KEY=generate-and-store-this-in-your-deployment-secret-manager

# Reader feed rollout. Keep behavior ranking at 0% through the shadow period,
# then raise to 10 and 50 only after the documented guardrails pass.
FEED_PERSONALIZATION_ENABLED=true
FEED_BEHAVIOR_ROLLOUT_PERCENT=0
FEED_HOLDOUT_PERCENT=10
FEED_SHADOW_RANKING_ENABLED=true
FEED_GUEST_LEARNING_ENABLED=false
FEED_SESSION_TTL_MINUTES=240

# Google Play In-App Review rollout. These defaults intentionally keep the
# automatic prompt disabled until an internal-track validation is complete.
REVIEW_PROMPT_ENABLED=false
REVIEW_PROMPT_ROLLOUT_PERCENT=0
REVIEW_PROMPT_MIN_VERSION_CODE=132
REVIEW_PROMPT_EXCLUDED_VERSION_CODES=
REVIEW_PROMPT_READER_ENABLED=false
REVIEW_PROMPT_WRITER_ENABLED=false

# For local development, place serviceAccountKey.json in server/ (it is ignored).
# For production, inject one of the following through your deployment secret store:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
# FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json

# Required in production; comma-separated browser origins.
# CORS_ORIGINS=https://app.example.com
